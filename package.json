{
  "name": "kancha-pm",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first personal project manager for your existing coding agent.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "kancha": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js dashboard",
    "demo": "node src/cli.js demo",
    "mcp": "node src/cli.js mcp",
    "test": "node --test",
    "setup": "node src/cli.js setup",
    "test:browser": "playwright test",
    "format": "prettier --write src web test browser-tests playwright.config.js",
    "worker": "node src/cli.js dashboard --notify",
    "status": "node src/cli.js status"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/dm-serif-text": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-static": "1.75.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1"
  }
}
